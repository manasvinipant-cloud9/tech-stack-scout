# Neon Postgres connection string (Neon dashboard -> Connection details, pooled)
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# AI route 1 (preferred): OpenRouter, Google models only, served only by Google's infrastructure.
OPENROUTER_API_KEY=
# Optional model overrides (both are Gemini Flash)
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-3.7-flash

# AI route 2 (used only when OPENROUTER_API_KEY is not set): Google AI Studio key
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional but recommended: raises GitHub API limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Secures /api/cron/refresh. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional: one line on what YOU sell, so outreach hooks connect to it
PRODUCT_PITCH=

# Optional but recommended: shared passcode that gates the whole app (cron route is exempt)
APP_PASSCODE=

# The seller's product, shown as "Fit with <name>", and a one-line description used for fit scoring and outreach openers
PRODUCT_NAME=

# Relevance checklist targets (the three contexts from the brief). Comma-separated; defaults shown.
ICP_CLOUDS=AWS,GCP,Azure
ICP_LANGUAGES=Go,Java,Python,TypeScript,Kotlin,Rust

# Optional second Gemini Flash model used when the first is overloaded
GEMINI_FALLBACK_MODEL=gemini-flash-latest
