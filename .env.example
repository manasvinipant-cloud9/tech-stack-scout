# Neon Postgres connection string (Neon dashboard -> Connection details, pooled)
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional but recommended: raises GitHub API limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Secures /api/cron/refresh. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional: one line on what YOU sell, so outreach hooks connect to it
PRODUCT_PITCH=

# Optional but recommended: shared passcode that gates the whole app (cron route is exempt)
APP_PASSCODE=

# The seller's product, shown as "Fit with <name>", and a one-line description used for fit scoring and outreach openers
PRODUCT_NAME=
